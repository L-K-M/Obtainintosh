    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/semver": "^7.7.1",
    "jsdom": "^26.1.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
