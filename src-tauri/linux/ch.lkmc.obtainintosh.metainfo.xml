<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for Linux software centers. tauri.linux.conf.json
     installs it in the .deb and the AppImage; scripts/build-flatpak.sh points
     the launchable at the Flatpak's renamed desktop file. -->
<component type="desktop-application">
  <id>ch.lkmc.obtainintosh</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Obtainintosh</name>
  <summary>Track GitHub and Forgejo releases</summary>
  <description>
    <p>
      Obtainintosh tracks programs published as GitHub and Forgejo releases,
      checks them for new versions, and downloads and installs updates.
    </p>
  </description>
  <developer id="ch.lkmc">
    <name>Lukas Mathis</name>
  </developer>
  <url type="homepage">https://github.com/L-K-M/Obtainintosh</url>
  <url type="bugtracker">https://github.com/L-K-M/Obtainintosh/issues</url>
  <launchable type="desktop-id">Obtainintosh.desktop</launchable>
</component>
